<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/node_code"
        android:layout_width="40dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:text="CN"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#18A058"
        android:background="@drawable/bg_code" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/node_country"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="中国"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1F2D3D" />

        <TextView
            android:id="@+id/node_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTTP · 24 ms"
            android:textSize="12sp"
            android:textColor="#9AA7B5" />
    </LinearLayout>

    <Button
        android:id="@+id/node_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="连接"
        android:textSize="13sp"
        android:minWidth="0dp"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:background="#18A058"
        android:textColor="#FFFFFF" />

</LinearLayout>
